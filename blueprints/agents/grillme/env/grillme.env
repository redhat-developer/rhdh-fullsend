# Sandbox env for the grillme agent.
# Mounted with expand: true so runner-side values are resolved before copy.

export PR_NUMBER="${PR_NUMBER:-${ISSUE_NUMBER:-}}"
export ISSUE_NUMBER="${ISSUE_NUMBER:-${PR_NUMBER:-}}"
export REPO_FULL_NAME="${REPO_FULL_NAME:-}"
export GITHUB_ISSUE_URL="${GITHUB_ISSUE_URL:-}"
export HUMAN_INSTRUCTION="${HUMAN_INSTRUCTION:-}"
export RUN_URL="${RUN_URL:-}"
export TRIGGER_SOURCE="${TRIGGER_SOURCE:-}"
